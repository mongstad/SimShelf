include README.md pyproject.toml package.json pnpm-lock.yaml pnpm-workspace.yaml
include tsconfig.json .npmrc start.sh requirements-dev.lock
recursive-include frontend *.tsx *.ts *.css *.mjs
recursive-include docs *.md
recursive-include examples *.py *.toml
recursive-include scripts *.py
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]

# Generated workspaces and captures never belong in source distributions.
prune .simshelf
prune .demo-workspace
prune .qa-workspace
prune docs/screenshots
prune examples/scalar_field/outputs
prune backups
